---
// Versión oscura de la portada. No es solo un cambio de colores: algunos textos y secciones
// son distintos de index.astro, por eso se mantiene como página propia.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Sponsor from '../components/Sponsor.astro';
import JoinCta from '../components/JoinCta.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { LUMA_URL, SITE_URL } from '../data/site';

const links = [
  { href: '#why', label: 'Why it matters' },
  { href: '#what', label: 'What we do' },
  { href: 'seminar.html', label: 'Seminars' },
  { href: 'about.html', label: 'About us' },
];
---
<Base
  title="W4AIS – Women For AI Safety (dark)"
  canonical={`${SITE_URL}/`}
  theme="dark"
  mobileCss="#network{text-align:center}
      #network>a{margin:0 auto}"
>
<Nav theme="dark" links={links} toggle="index.html" joinHref="#join" />

<header style="border-bottom:1px solid #3a3532">
  <div style="max-width:1180px;margin:0 auto;padding:72px 24px 64px;display:flex;flex-direction:column;gap:20px">
    <span style="display:inline-block;width:40px;height:3px;background:#5a7ef8"></span>
    <h1 style="font-size:clamp(32px,7.6vw,52px);line-height:1.1;font-weight:700;letter-spacing:-0.01em;max-width:18ch;margin:0;color:#efe9e2;text-wrap:balance">AI safety needs every capable person it can get.</h1>
    <p style="font-size:clamp(17px,4.2vw,19px);line-height:1.5;font-weight:500;max-width:42ch;margin:0;color:#b3ac9f;text-wrap:pretty">W4AIS is the career network that helps women get into the field and move up in it.</p>
    <div style="display:flex;gap:14px;margin-top:8px;flex-wrap:wrap">
      <a href="#join" style="text-decoration:none;font-weight:700;font-size:15px;color:#fff;background:#3f56a1;padding:13px 24px;border-radius:6px">Join the network</a>
      <a href="#what" style="text-decoration:none;font-weight:700;font-size:15px;color:#efe9e2;padding:13px 24px;border-radius:6px;border:1px solid #3a3532">See what we do</a>
    </div>
  </div>
</header>

<Sponsor theme="dark" />

<section id="why" style="max-width:820px;margin:0 auto;padding:72px 24px">
  <h2 style="font-size:clamp(26px,6.5vw,32px);line-height:1.2;font-weight:800;letter-spacing:-0.01em;max-width:16ch;color:#fff">Why this matters</h2>
  <p style="font-size:17px;line-height:1.65;color:#b6b4c2;max-width:68ch;text-wrap:pretty">The field working to make AI go well is still small, and the decisions it makes now will shape how this technology develops. It's short of people in operations, governance, policy and leadership, and many capable women never find a way in: no network, no one to ask, no clear route from where they are to where the work is.</p>
  <p style="font-size:17px;line-height:1.65;color:#b6b4c2;max-width:68ch;text-wrap:pretty">W4AIS is that route. We connect you with women already doing the work, through talks, networking sessions and mentoring, so you can see what the jobs actually look like and take a concrete next step.</p>
  <p style="font-size:17px;line-height:1.65;color:#b6b4c2;max-width:68ch;text-wrap:pretty">Whether you already work in AI safety, alignment, governance or policy, or you're coming from another field and wondering where you'd fit, this is where you find opportunities, get visibility and meet the people who can open doors.</p>
</section>

<section id="what" style="max-width:820px;margin:0 auto;padding:24px 24px 72px">
  <h2 style="font-size:32px;font-weight:800;letter-spacing:-0.01em;margin-bottom:8px;color:#fff">What we're building</h2>
  <p style="font-size:16px;line-height:1.6;color:#b3ac9f;margin:0 0 8px;max-width:56ch">Right now, that means one thing: <strong style="color:#8fa7fa">the network</strong>.<br>Here's what it will open up.</p>
  <div style="border-top:1px solid #3a3532">
    <div style="display:flex;gap:32px;padding:32px 0;border-bottom:1px solid #3a3532;align-items:baseline">
      <span style="font-size:14px;font-weight:800;color:#8fa7fa;width:24px;flex-shrink:0">01</span>
      <div>
        <h3 style="font-size:20px;font-weight:700;margin:0 0 6px;color:#fff">Find your next role</h3>
        <p style="font-size:16px;color:#b3ac9f;margin:0;line-height:1.6;max-width:52ch">Roles, fellowships and introductions surfaced from inside the field.</p>
      </div>
    </div>
    <div style="display:flex;gap:32px;padding:32px 0;border-bottom:1px solid #3a3532;align-items:baseline">
      <span style="font-size:14px;font-weight:800;color:#8fa7fa;width:24px;flex-shrink:0">02</span>
      <div>
        <h3 style="font-size:20px;font-weight:700;margin:0 0 6px;color:#fff">Be seen for your work</h3>
        <p style="font-size:16px;color:#b3ac9f;margin:0;line-height:1.6;max-width:52ch">Speaking slots, features and referrals that put you in front of the right people.</p>
      </div>
    </div>
    <div style="display:flex;gap:32px;padding:32px 0;border-bottom:1px solid #3a3532;align-items:baseline">
      <span style="font-size:14px;font-weight:800;color:#8fa7fa;width:24px;flex-shrink:0">03</span>
      <div>
        <h3 style="font-size:20px;font-weight:700;margin:0 0 6px;color:#fff">Meet people who open doors</h3>
        <p style="font-size:16px;color:#b3ac9f;margin:0;line-height:1.6;max-width:52ch">A working network across alignment, governance and policy — not a mailing list.</p>
      </div>
    </div>
  </div>
</section>

<section id="gather" style="max-width:820px;margin:0 auto;padding:24px 24px 80px">
  <h2 style="font-size:32px;font-weight:800;letter-spacing:-0.01em;margin-bottom:12px;color:#fff">How we gather</h2>
  <p style="font-size:18px;line-height:1.6;max-width:46ch;color:#c9c2b5">We gather regularly: real conversations, real connections — not just another panel to watch.</p>
  <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
    <a href={LUMA_URL} target="_blank" rel="noopener" style="text-decoration:none;font-size:13px;font-weight:700;padding:6px 14px;border-radius:999px;background:#2a3050;color:#bac9fc">Twice a month, on Wednesdays, online</a>
    <a href={LUMA_URL} target="_blank" rel="noopener" style="text-decoration:none;font-size:13px;font-weight:700;padding:6px 14px;border-radius:999px;background:#4a3226;color:#f6b98a">Luma</a>
  </div>
</section>

<section id="network" style="max-width:820px;margin:0 auto;padding:24px 24px 80px;display:flex;gap:32px;flex-wrap:wrap;align-items:center;justify-content:space-between">
  <div style="flex:1 1 260px;min-width:0">
    <h2 style="font-size:26px;font-weight:800;letter-spacing:-0.01em;margin-bottom:8px;color:#fff">Network</h2>
    <p style="font-size:16px;line-height:1.6;color:#b3ac9f;max-width:52ch;margin:0">We're part of the global AI safety ecosystem, collaborating closely with BlueDot Impact and the international network of local hubs.</p>
  </div>
  <a href="https://aisafety.es/" target="_blank" rel="noopener" style="flex-shrink:0"><img src="ias-logo.png" alt="iaS — Hub de IA Safety" style="height:80px;width:auto;background:#efe9e2;border-radius:12px;padding:8px 14px"></a>
</section>

<JoinCta theme="dark" />

<footer style="max-width:1180px;margin:0 auto;padding:40px 24px 56px;display:flex;flex-direction:column;gap:24px">
<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px">
  <a href="index.html" style="display:flex;flex-shrink:0"><img src="logo_blanco_cropped.png" alt="W4AIS" style="height:auto;width:110px"></a>
  <div style="display:flex;gap:24px;flex-wrap:wrap">
    <a href="#why" style="text-decoration:none;font-size:14px;font-weight:700;color:#c9c2b5">Why it matters</a>
    <a href="#what" style="text-decoration:none;font-size:14px;font-weight:700;color:#c9c2b5">What we do</a>
    <a href="#join" style="text-decoration:none;font-size:14px;font-weight:700;color:#c9c2b5">Join</a>
  </div>
  <SocialLinks color="#8fa7fa" />
  <span style="font-size:12px;font-weight:700;color:#948c7d">© 2026 Women4AISafety</span>
</div>
<span style="font-size:12px;color:#948c7d">Part of the global AI safety ecosystem.</span>
</footer>
</Base>
