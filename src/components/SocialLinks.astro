---
// Iconos de contacto y redes del pie de la portada.
interface Props {
  color: string;
}

const { color } = Astro.props;
const linkStyle = 'color:inherit;display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:9px;margin:-9px;box-sizing:border-box';
---
<div style={`display:flex;gap:38px;align-items:center;color:${color}`}>
  <a href="mailto:w4ais@women4aisafety.com" aria-label="Email" style={linkStyle}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5" stroke="currentColor" stroke-width="2.4"></rect><path d="M3.5 6L12 13L20.5 6" stroke="currentColor" stroke-width="2.4" fill="none"></path></svg>
  </a>
  <a href="https://www.instagram.com/womenaisafety/" target="_blank" rel="noopener" aria-label="Instagram" style={linkStyle}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2.4"></rect><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="2.4"></circle><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor"></circle></svg>
  </a>
  <a href="https://www.linkedin.com/company/women4aisafety/" target="_blank" rel="noopener" aria-label="LinkedIn" style={linkStyle}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="2.4"></rect><circle cx="8" cy="8.3" r="1.2" fill="currentColor"></circle><line x1="8" y1="11.5" x2="8" y2="17" stroke="currentColor" stroke-width="2.4"></line><path d="M12 17V12.5C12 11.4 12.9 10.5 14 10.5C15.1 10.5 16 11.4 16 12.5V17" stroke="currentColor" stroke-width="2.4" fill="none"></path><line x1="12" y1="11.5" x2="12" y2="17" stroke="currentColor" stroke-width="2.4"></line></svg>
  </a>
  <a href="https://www.youtube.com/@women4aisafety" target="_blank" rel="noopener" aria-label="YouTube" style={linkStyle}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="2.5" y="5.5" width="19" height="13" rx="4" stroke="currentColor" stroke-width="2.4"></rect><path d="M10 9L15.5 12L10 15V9Z" fill="currentColor"></path></svg>
  </a>
  <a href="https://aisafetyfundamentals.slack.com/archives/C09BBRVTD1N" target="_blank" rel="noopener" aria-label="Slack" style={linkStyle}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="9" y="2.5" width="3.4" height="8.5" rx="1.7" stroke="currentColor" stroke-width="2"></rect><rect x="12" y="12.5" width="3.4" height="8.5" rx="1.7" stroke="currentColor" stroke-width="2"></rect><rect x="12.5" y="9" width="8.5" height="3.4" rx="1.7" stroke="currentColor" stroke-width="2"></rect><rect x="2.5" y="12" width="8.5" height="3.4" rx="1.7" stroke="currentColor" stroke-width="2"></rect></svg>
  </a>
</div>
