---
import type { ChapterEvent } from '../data/chapters';
import type { Theme } from '../data/site';

// Galería de fotos de un evento ya celebrado, con visor a pantalla completa (<dialog>).
// Cada foto está en public/ como «src.jpg» (grande, para el visor) y «src-sm.jpg» (para la cuadrícula).
interface Props {
  event: ChapterEvent;
  theme?: Theme;
  // Texto pequeño sobre el título, por ejemplo «24 November 2026 · Celonis, Madrid».
  kicker: string;
  heading: string;
}

const { event: e, theme = 'light', kicker, heading } = Astro.props;
const dark = theme === 'dark';
---
<section class={`gallery${dark ? ' dark' : ''}`} aria-labelledby="gallery-title">
  <div class="gallery-head">
    <span class="gallery-kicker">{kicker}</span>
    <h2 id="gallery-title">{heading}</h2>
    {e.recap && <p>{e.recap}</p>}
  </div>
  <ul class="gallery-grid">
    {e.photos.map((p, i) => (
      <li class={p.size ?? ''}>
        <button type="button" data-index={i} aria-label={`Open photo: ${p.alt}`}>
          <img
            src={`${p.src}-sm.jpg`}
            srcset={`${p.src}-sm.jpg 800w, ${p.src}.jpg 1600w`}
            sizes={p.size === 'large' ? '(max-width: 760px) 100vw, 590px' : p.size === 'wide' ? '(max-width: 760px) 100vw, 590px' : '(max-width: 760px) 50vw, 295px'}
            alt={p.alt}
            width="800"
            height="533"
            loading={i < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </button>
      </li>
    ))}
  </ul>
  {e.photoCredit && <p class="gallery-credit">Photos: {e.photoCredit}</p>}

  <dialog class="lightbox" aria-label="Event photos">
    <img alt="" />
    <p class="lightbox-caption"></p>
    <button type="button" class="lb-close" aria-label="Close">×</button>
    <button type="button" class="lb-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="lb-next" aria-label="Next photo">›</button>
  </dialog>
  <script type="application/json" class="gallery-data" set:html={JSON.stringify(e.photos.map((p) => ({ src: `${p.src}.jpg`, alt: p.alt })))} />
</section>

<style>
  .gallery { max-width: 1180px; margin: 0 auto; padding: 72px 24px 16px; }
  .gallery-head { max-width: 62ch; margin-bottom: 32px; }
  .gallery-kicker { display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #7a6be0; margin-bottom: 12px; }
  .gallery h2 { font-size: 40px; line-height: 1.1; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 16px; color: oklch(0.22 0.01 260); }
  .gallery-head p { font-size: 18px; line-height: 1.65; font-weight: 500; margin: 0; color: oklch(0.4 0.01 260); }
  .gallery-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 210px; grid-auto-flow: dense; gap: 12px; }
  .gallery-grid li.large { grid-column: span 2; grid-row: span 2; }
  .gallery-grid li.wide { grid-column: span 2; }
  .gallery-grid button { display: block; width: 100%; height: 100%; padding: 0; border: 0; border-radius: 16px; overflow: hidden; cursor: zoom-in; background: oklch(0.93 0.01 280); }
  .gallery-grid img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s cubic-bezier(.2,.7,.2,1), filter .5s; }
  .gallery-grid button:hover img, .gallery-grid button:focus-visible img { transform: scale(1.04); filter: saturate(1.08); }
  .gallery-grid button:focus-visible { outline: 3px solid #7a6be0; outline-offset: 3px; }
  .gallery-credit { font-size: 13px; font-weight: 600; margin: 14px 0 0; color: oklch(0.5 0.01 260); text-align: right; }

  .gallery.dark h2 { color: #fff; }
  .gallery.dark .gallery-kicker { color: #bac9fc; }
  .gallery.dark .gallery-head p { color: #b3ac9f; }
  .gallery.dark .gallery-credit { color: #8a8278; }
  .gallery.dark .gallery-grid button { background: #292522; }

  .lightbox { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(12, 10, 20, .94); }
  .lightbox[open] { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: calc(100vw - 140px); max-height: calc(100vh - 110px); object-fit: contain; border-radius: 10px; }
  .lightbox-caption { margin: 0; padding: 0 24px; font-size: 15px; font-weight: 600; color: #efe9e2; text-align: center; }
  .lightbox button { position: absolute; border: 0; cursor: pointer; color: #fff; background: rgba(255,255,255,.12); border-radius: 999px; width: 48px; height: 48px; font-size: 30px; line-height: 1; display: grid; place-items: center; }
  .lightbox button:hover { background: rgba(255,255,255,.24); }
  .lb-close { top: 18px; right: 18px; }
  .lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 18px; top: 50%; transform: translateY(-50%); }

  @media (max-width: 760px) {
    .gallery { padding-top: 56px; }
    .gallery h2 { font-size: 30px; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; gap: 8px; }
    .gallery-grid button { border-radius: 12px; }
    .lightbox img { max-width: 100vw; border-radius: 0; }
    .lb-prev, .lb-next { top: auto; bottom: 18px; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .gallery-grid img { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const photos: { src: string; alt: string }[] = JSON.parse(gallery.querySelector('.gallery-data')?.textContent ?? '[]');
    const dialog = gallery.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('.lightbox-caption')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + photos.length) % photos.length;
      img.src = photos[current].src;
      img.alt = photos[current].alt;
      caption.textContent = `${photos[current].alt} · ${current + 1}/${photos.length}`;
    };

    gallery.querySelectorAll<HTMLButtonElement>('.gallery-grid button').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.index)); dialog.showModal(); }),
    );
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
    // Clic fuera de la foto cierra el visor.
    dialog.addEventListener('click', (ev) => { if (ev.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowLeft') show(current - 1);
      if (ev.key === 'ArrowRight') show(current + 1);
    });
  });
</script>
