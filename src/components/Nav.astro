---
import { pageHref, type Theme } from '../data/site';

interface Props {
  theme?: Theme;
  links: { href: string; label: string }[];
  // Botón 🌙 / ☀️ que lleva a la otra versión de la página.
  toggle?: string;
  joinHref?: string;
  logoAlt?: string;
}

const { theme = 'light', links, toggle, joinHref = pageHref('index', theme, '#join'), logoAlt = 'W4AIS' } = Astro.props;
const dark = theme === 'dark';
const linkStyle = 'text-decoration:none;font-weight:600;font-size:15px;color:inherit';
const joinStyle = dark
  ? 'text-decoration:none;font-weight:700;font-size:15px;color:#211f1e;background:#8fa7fa;padding:13px 20px;border-radius:999px'
  : 'text-decoration:none;font-weight:700;font-size:15px;color:#fff;background:#3f56a1;padding:13px 20px;border-radius:999px';
const toggleLabel = dark ? 'Light mode' : 'Dark mode';
---
<nav style="max-width:1180px;margin:0 auto;display:flex;align-items:center;gap:16px;padding:20px 24px;position:relative">
  <a href={pageHref('index', theme)} style="display:flex;margin-right:auto"><img src={dark ? 'logo_blanco_cropped.png' : 'logo_color_cropped.png'} alt={logoAlt} style="height:64px;width:auto"></a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle">
  <label for="nav-toggle" class="nav-burger" aria-label="Open menu"><span></span><span></span><span></span></label>
  <div class="nav-links" style="align-items:center;gap:16px">
    {links.map((link) => <a href={link.href} style={linkStyle}>{link.label}</a>)}
    {toggle && (
      <a href={toggle} aria-label={toggleLabel} style={`${linkStyle};display:flex;align-items:center`} title={toggleLabel}>{dark ? '☀️' : '🌙'}</a>
    )}
    <a href={joinHref} style={joinStyle}>Join us</a>
  </div>
</nav>
